# ==============================================================================
# ScaleSync - Production Environment Variables Configuration Template
# ==============================================================================
# NOTE: Fill in real values in your Render.com / Cloud Environment dashboard.
# NEVER commit .env files containing production passwords or keys to git.
# ==============================================================================

# Database Connection (Supabase / PostgreSQL)
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# JWT Secret Key (Generate a random 32+ character string)
SECRET_KEY=generate_a_secure_random_string_for_production_jwt

# JWT Token Expiration in Minutes (e.g. 1440 for 24 hours, 60 for 1 hour)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment Mode
ENVIRONMENT=production

# Dynamic Port (Injected automatically by Render at runtime)
PORT=8000

# Dual SMS & Email OTP Credentials (Optional for live third-party gateway integrations)
# SMS_GATEWAY_API_KEY=your_sms_gateway_key
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@domain.com
# SMTP_PASSWORD=your_smtp_app_password
